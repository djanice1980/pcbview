# Maintainer: David Janice <djanice1980@gmail.com>
#
# Arch/CachyOS package for pcbview. Build and install with:
#   cd packaging/linux && makepkg -si
# makepkg resolves depends/makedepends itself (the -s flag), and pacman prints
# the optdepends list -- with the reason each one is wanted -- at install time,
# so the KiCad 3D component-body support and the CPU rendering device are
# offered as choices rather than silently absent.
#
# Sources are taken from the repo this file sits in (two levels up), so a
# local checkout builds as-is; switch `source` to a release tarball when
# publishing to the AUR.

pkgname=pcbview
pkgver=1.22.0
pkgrel=1
pkgdesc="Standalone GPU-accelerated 3D viewer for KiCad projects and Gerber packages"
arch=(x86_64)
url="https://github.com/djanice1980/pcbview"
license=(GPL-3.0-only)
depends=(
    qt6-base
    sdl3
    openxr
    embree
    openimagedenoise
    vulkan-icd-loader
    onetbb
    hicolor-icon-theme
)
makedepends=(
    cmake
    ninja
    git
    vulkan-headers
    shaderc
)
optdepends=(
    'kicad: 3D component bodies on KiCad boards (kicad-cli export)'
    'kicad-library-3d: the component 3D models kicad-cli exports from'
    'vulkan-swrast: CPU rendering device (no GPU required)'
    'ffmpeg: showcase video recording'
)

# Build from the working tree this PKGBUILD lives in.
pkgver() {
    # Keep the version in lockstep with CMakeLists.txt, the single source.
    sed -n 's/^project(pcbview VERSION \([0-9.]*\).*/\1/p' "$startdir/../../CMakeLists.txt"
}

build() {
    cmake -S "$startdir/../.." -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release
    cmake --build build
}

check() {
    # The geometry/importer regression suite; needs neither GPU nor display.
    cd "$startdir/../.."
    "$srcdir/build/pcbview_tests"
}

package() {
    install -Dm755 "$srcdir/build/pcbview" "$pkgdir/usr/bin/pcbview"
    install -Dm644 "$startdir/pcbview.desktop" \
        "$pkgdir/usr/share/applications/pcbview.desktop"
    install -Dm644 "$startdir/../../assets/pcbview_256.png" \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/pcbview.png"
    install -Dm644 "$startdir/../../assets/pcbview_1024.png" \
        "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/pcbview.png"
    install -Dm644 "$startdir/../../LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$startdir/../../NOTICE.md" \
        "$pkgdir/usr/share/licenses/$pkgname/NOTICE.md"
}
