#version 450

// Temporal reprojection: reuse the previous frame's result for pixels that
// still show the same point in the world.
//
// This is the piece that makes path tracing possible on a headset. Tracing 128
// samples a frame is a slideshow; tracing a handful and REUSING what was
// already computed gets the same effective count for a fraction of the cost.
// The desktop achieves it by holding the camera still and accumulating in
// screen space, which is only valid while the camera does not move. A head
// always moves. So instead of assuming a pixel still means the same thing,
// this works out where its world point WAS on screen last frame and fetches
// the history from there -- correct however far you have moved.
//
// It also fixes the crawling. Independent frames each carry a different random
// noise pattern, so whatever the spatial filter cannot remove changes shape
// every frame and the image appears to swim. Reusing history makes the noise
// itself stop changing, which is what actually settles the picture.
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D curColour;
layout(set = 0, binding = 1, rgba32f) uniform readonly image2D curPos;
layout(set = 0, binding = 2, rgba32f) uniform readonly image2D curNormal;
layout(set = 0, binding = 3, rgba32f) uniform readonly image2D histColour;
layout(set = 0, binding = 4, rgba32f) uniform readonly image2D histPos;
layout(set = 0, binding = 5, rgba32f) uniform writeonly image2D outColour;

float luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

layout(push_constant) uniform Push {
    mat4 prevViewProj;  // world(mm) -> clip, as it was LAST frame
    uvec4 dim;          // x width, y height, z reset (1 = ignore history)
    // x = 1/samples (curColour and curNormal are running sums)
    // y = position tolerance, absolute world distance
    // z = max history frames
    // w = history frames for CLAMPED (edge) reuse -- deliberately short, so a
    //     genuinely new surface resolves quickly while the edge stops walking
    vec4 params;
    vec3 eye;           // viewpoint, same space as the position AOV
} pc;

void main() {
    const ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.dim.x) || px.y >= int(pc.dim.y)) return;

    const float invSamples = pc.params.x;
    vec3 cur = imageLoad(curColour, px).rgb * invSamples;
    const vec4 pos = imageLoad(curPos, px);

    // FIREFLY CLAMP, and temporal reuse is what makes it necessary.
    //
    // At a handful of samples a frame, one path occasionally finds a very
    // bright route -- a glancing specular, a lucky bounce off gold -- and lands
    // a single pixel orders of magnitude above its neighbours. Without history
    // that flickers for one frame and is gone. WITH history it gets averaged in
    // and then decays slowly over the whole history length, so a momentary
    // flicker becomes a lingering dot on the board.
    //
    // A real highlight covers several pixels; a firefly is one pixel that
    // disagrees with everything around it. So clamp against the local mean
    // rather than a fixed ceiling, which would flatten genuine bright detail.
    // The same sweep also gives the colour BOX used further down to clamp
    // history at edges, so it is gathered once here.
    vec3 nbMin = vec3(1.0e30);
    vec3 nbMax = vec3(-1.0e30);
    {
        vec3 mean = vec3(0.0);
        float cnt = 0.0;
        for (int dy = -1; dy <= 1; ++dy) {
            for (int dx = -1; dx <= 1; ++dx) {
                const ivec2 q = px + ivec2(dx, dy);
                if (q.x < 0 || q.y < 0 || q.x >= int(pc.dim.x) ||
                    q.y >= int(pc.dim.y))
                    continue;
                const vec3 c = imageLoad(curColour, q).rgb * invSamples;
                mean += c;
                nbMin = min(nbMin, c);
                nbMax = max(nbMax, c);
                cnt += 1.0;
            }
        }
        mean /= max(cnt, 1.0);
        const float lc = luma(cur);
        const float limit = luma(mean) * 4.0 + 0.05;
        if (lc > limit && lc > 1.0e-6) cur *= limit / lc;
    }

    // Sky, or the history has been invalidated wholesale (the board moved, the
    // scene changed). Nothing to reuse.
    if (pos.w < 0.5 || pc.dim.z != 0u) {
        imageStore(outColour, px, vec4(cur, 1.0));
        return;
    }

    // Where this world point sat on screen last frame.
    const vec4 clip = pc.prevViewProj * vec4(pos.xyz, 1.0);
    if (clip.w <= 0.0) {                      // behind the previous viewpoint
        imageStore(outColour, px, vec4(cur, 1.0));
        return;
    }
    const vec2 ndc = clip.xy / clip.w;
    const vec2 uv = ndc * 0.5 + 0.5;

    // BILINEAR history fetch, with every tap validated separately.
    //
    // A single nearest-neighbour lookup is what makes silhouettes crawl. The
    // reprojected position almost never lands on a pixel centre, so as the head
    // drifts by a fraction of a pixel the chosen texel flips between the chip
    // and the board behind it. Along an edge that happens constantly: history
    // is thrown away, the pixel falls back to a few raw samples, and since the
    // noise is different every frame the whole outline boils.
    //
    // Taking the four surrounding texels and testing each one on its own means
    // an edge pixel keeps whichever of its neighbours genuinely belong to the
    // same surface, instead of losing everything because the nearest one did
    // not.
    const vec2 prevF = uv * vec2(pc.dim.xy) - 0.5;
    const ivec2 base = ivec2(floor(prevF));
    const vec2 f = prevF - vec2(base);
    const float bw[4] = float[](
        (1.0 - f.x) * (1.0 - f.y), f.x * (1.0 - f.y),
        (1.0 - f.x) * f.y,         f.x * f.y);
    const ivec2 off[4] =
        ivec2[](ivec2(0, 0), ivec2(1, 0), ivec2(0, 1), ivec2(1, 1));

    // DISOCCLUSION TEST, and everything rests on it.
    //
    // A pixel can reproject to a perfectly valid screen position that shows a
    // DIFFERENT surface -- the board behind a chip, revealed as you move. Its
    // history belongs to the chip, and blending it in drags the chip's colour
    // across the newly-visible board: a smear trailing every object.
    //
    // An ABSOLUTE world distance, deliberately not scaled by how far away the
    // viewer is.
    //
    // It used to scale with view distance, on the reasoning that a pixel covers
    // more world at range. True, but irrelevant: what this test discriminates
    // is a chip's HEIGHT or a via's thickness, and those are fixed in
    // millimetres however you look at them. Scaling made it too slack far away
    // -- a whole millimetre of tolerance, enough to let a package top and the
    // board trade history -- and tighter than copper thickness up close, where
    // it rejected everything and the picture crawled. Measured exactly as the
    // symptom described: bleed at distance, crawl close up.
    const float tol = pc.params.y;

    // Measured ALONG THE NORMAL, not straight-line -- and this is the whole
    // difference between edges that settle and edges that boil.
    //
    // The position AOV comes from a single jittered sample, so the point it
    // records wanders by roughly a pixel's worth of world every frame. A
    // straight-line test cannot tell that wander apart from a genuine change of
    // surface: at any silhouette, where one pixel of lateral movement spans a
    // large depth step, it fails every frame. History is thrown away, the pixel
    // drops to two raw samples, and the outline boils. The same thing happens
    // to a via top, which is a sub-pixel feature whose sample lands on copper
    // one frame and mask the next.
    //
    // Distance along the normal ignores lateral wander entirely -- two points
    // on the same face are ~0 apart however far they slide across it -- while
    // still separating a chip top from the board beside it by the package's
    // full height, which is exactly the discrimination wanted.
    const vec3 nrm = normalize(imageLoad(curNormal, px).xyz * invSamples +
                               vec3(1.0e-9));

    vec3 sum = vec3(0.0);
    float wsum = 0.0;
    float nsum = 0.0;
    for (int i = 0; i < 4; ++i) {
        const ivec2 q = base + off[i];
        if (q.x < 0 || q.y < 0 || q.x >= int(pc.dim.x) ||
            q.y >= int(pc.dim.y))
            continue;
        const vec4 hp = imageLoad(histPos, q);
        if (hp.w < 0.5) continue;
        const vec3 delta = hp.xyz - pos.xyz;
        // Off the plane by more than the tolerance: a different surface.
        if (abs(dot(delta, nrm)) >= tol) continue;
        // Still bounded laterally, generously. Without this, a point far across
        // the same flat plane would qualify -- these taps are adjacent pixels,
        // so anything genuinely distant is a reprojection gone wrong.
        if (length(delta) >= tol * 32.0) continue;
        const vec4 hc = imageLoad(histColour, q);
        sum += hc.rgb * bw[i];
        nsum += hc.a * bw[i];
        wsum += bw[i];
    }

    if (wsum <= 1.0e-6) {
        // The geometry test says this is a different surface. Throwing the
        // history away outright is what makes edges walk.
        //
        // At a silhouette a pixel is classified ALL chip or ALL board -- the
        // geometry buffer is deterministic, so there is no partial coverage.
        // Drift your head a fraction of a pixel, the classification flips, the
        // history is discarded, and the pixel snaps wholesale to the other
        // surface's colour. Stair-steps that jump between positions: an
        // escalator rather than a staircase. And the flipping is genuine, so no
        // amount of tightening or loosening the test removes it.
        //
        // So CLAMP rather than discard, which is what temporal antialiasing
        // does for exactly this case. History is pulled into the range of
        // colours this frame actually produced nearby, which bounds how wrong
        // it can be -- a chip's colour cannot survive on newly revealed board,
        // because the board's colours are what the box is made of -- while
        // still carrying enough of the past to stop the edge snapping. Held to
        // a short history so genuinely new surfaces still resolve quickly.
        vec3 fb = vec3(0.0);
        float fw = 0.0;
        for (int i = 0; i < 4; ++i) {
            const ivec2 q = base + off[i];
            if (q.x < 0 || q.y < 0 || q.x >= int(pc.dim.x) ||
                q.y >= int(pc.dim.y))
                continue;
            fb += imageLoad(histColour, q).rgb * bw[i];
            fw += bw[i];
        }
        if (fw <= 1.0e-6) {
            imageStore(outColour, px, vec4(cur, 1.0));
            return;
        }
        const vec3 clamped = clamp(fb / fw, nbMin, nbMax);
        const float edgeN = min(pc.params.w, pc.params.z);
        imageStore(outColour, px,
                   vec4(mix(clamped, cur, 1.0 / edgeN), edgeN));
        return;
    }

    const vec3 histRgb = sum / wsum;
    // How many frames this pixel has been accumulating. Capping it bounds how
    // far back the average reaches: unbounded takes a second to respond to a
    // change, too short barely denoises. The cap IS the quality/latency dial.
    // Carried on into the filter, which leans harder on pixels with little.
    const float n = min(nsum / wsum + 1.0, pc.params.z);
    const vec3 blended = mix(histRgb, cur, 1.0 / n);
    imageStore(outColour, px, vec4(blended, n));
}
