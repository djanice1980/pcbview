#version 450

// Edge-aware a-trous wavelet denoise, run entirely on the GPU.
//
// Why this and not OIDN. The existing OIDN path is a HOST round trip: the
// accumulation and its two guide images are copied to mapped buffers, filtered
// on the CPU side, and copied back. At eye resolution that is roughly 200 MB
// across PCIe per eye per frame before the network does any work, which is why
// it runs asynchronously over several frames and why it can never serve a
// headset. This never leaves the GPU and costs well under a millisecond a pass.
//
// The filter is Dammertz et al.'s a-trous edge-avoiding wavelet: a 5x5 B-spline
// kernel applied repeatedly with the tap spacing DOUBLING each pass, so N passes
// reach a 2^N-wide neighbourhood for N*25 taps rather than 4^N. Taps are
// rejected when they disagree with the centre pixel about which surface they
// are on, using the first-hit normal and albedo the tracer already writes as
// AOVs -- that is what keeps component edges and silkscreen sharp while the
// noise between them averages away.
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D srcImg;
layout(set = 0, binding = 1, rgba32f) uniform writeonly image2D dstImg;
layout(set = 0, binding = 2, rgba32f) uniform readonly image2D albedoImg;
layout(set = 0, binding = 3, rgba32f) uniform readonly image2D normalImg;
// First-hit world position, so the filter knows how much WORLD its taps cover
// and not merely how many pixels.
layout(set = 0, binding = 4, rgba32f) uniform readonly image2D posImg;

layout(push_constant) uniform Push {
    uvec4 dim;      // x width, y height, z step width, w pass index
    vec4 sigma;     // x normal power, y luminance, z albedo, w input scale
    // x = 1/samples, for the GUIDES.
    //
    // The tracer accumulates its albedo and normal AOVs the same way it
    // accumulates colour -- they are running SUMS, not averages, because a
    // single sample's first-hit albedo is a coin flip under stochastic mask
    // alpha. So they need dividing too. Reading them raw made the albedo
    // difference scale with the sample count, and at 16 spp that drove the
    // material weight to zero for any difference at all, rejecting nearly every
    // tap: the filter ran and did almost nothing.
    vec4 misc;
} pc;

float luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

void main() {
    const ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.dim.x) || px.y >= int(pc.dim.y)) return;

    // `scale` folds the accumulation divide into the first pass: pass 0 reads
    // the running radiance SUM and needs 1/samples, later passes read an
    // already-averaged image and pass 1.0.
    const vec4 srcC = imageLoad(srcImg, px);
    const vec3 centre = srcC.rgb * pc.sigma.w;

    // How many frames of history this pixel carries, written by the temporal
    // pass into alpha and forwarded by every pass below. 0 when temporal reuse
    // is off, which simply leaves the scaling at 1.
    //
    // Filter strength follows it. A pixel with a long history is already an
    // average of many samples and needs almost no spatial help -- blurring it
    // only destroys detail. A freshly disoccluded pixel has one frame's worth
    // of samples and needs all the help it can get. Those are exactly the
    // pixels along a silhouette, which is why edges crawl when every pixel is
    // filtered the same amount regardless of what it actually knows.
    const float hist = max(srcC.a, 1.0);
    const float boost = clamp(8.0 / sqrt(hist), 1.0, 8.0);

    // Where this pixel is in the world. The tap spacing doubles each pass and
    // reaches 32 pixels, which is a modest patch of board seen from close to
    // and a large one seen from far away -- so a filter bounded only in pixels
    // quietly blends across more and more distinct materials as you back away.
    // That is exactly the colour bleed that got worse with distance. Bounding
    // the reach in MILLIMETRES makes the filter cover the same amount of board
    // wherever you stand.
    const vec4 pC = imageLoad(posImg, px);
    const float worldRadius = pc.misc.y;
    const vec4 nSrc = imageLoad(normalImg, px);
    const vec3 nRaw = nSrc.xyz;
    // Material id, written alongside the deterministic normal. 0 = no id.
    const float matC = nSrc.w;
    const vec3 aC = imageLoad(albedoImg, px).rgb * pc.misc.x;
    const float lC = luma(centre);

    // Background (no geometry hit) has a zero normal. Filtering it against the
    // board would drag the sky into silhouettes, so leave it alone. This also
    // guards the normalize below against a zero vector.
    if (dot(nRaw, nRaw) < 1e-6) {
        imageStore(dstImg, px, vec4(centre, 1.0));
        return;
    }
    // Normalised before use, deliberately: the orientation weight raises the
    // dot product to a high power, so a stored normal even slightly longer
    // than unit would explode rather than fall off, and a slightly shorter one
    // would drive every weight to zero.
    const vec3 nC = normalize(nRaw);

    const float kernel[5] = float[](0.0625, 0.25, 0.375, 0.25, 0.0625);
    const int step = int(pc.dim.z);

    vec3 sum = vec3(0.0);
    float wsum = 0.0;

    for (int dy = -2; dy <= 2; ++dy) {
        for (int dx = -2; dx <= 2; ++dx) {
            const ivec2 q = px + ivec2(dx, dy) * step;
            if (q.x < 0 || q.y < 0 || q.x >= int(pc.dim.x) ||
                q.y >= int(pc.dim.y))
                continue;

            const vec3 cQ = imageLoad(srcImg, q).rgb * pc.sigma.w;
            const vec4 nQsrc = imageLoad(normalImg, q);
            const vec3 nQraw = nQsrc.xyz;
            if (dot(nQraw, nQraw) < 1e-6) continue;  // never pull sky in
            const vec3 nQ = normalize(nQraw);
            // Different material: never mix them. Silkscreen, copper and mask
            // share a plane and a normal, so this is the ONLY thing that keeps
            // text and traces crisp -- and unlike an albedo distance it is
            // exact, with no threshold to tune and no blend at the boundary.
            if (matC > 0.0 && nQsrc.w != matC) continue;
            // Too far away in the WORLD to be the same surface detail, however
            // few pixels separate them on screen.
            if (worldRadius > 0.0 && pC.w > 0.5) {
                const vec4 pQ = imageLoad(posImg, q);
                if (pQ.w < 0.5 || distance(pQ.xyz, pC.xyz) > worldRadius)
                    continue;
            }
            const vec3 aQ = imageLoad(albedoImg, q).rgb * pc.misc.x;

            // Orientation and material, both RELAXED for pixels with little
            // history -- and this is the case the boost was built for.
            //
            // At a silhouette the guides are themselves a blend: samples jitter
            // across the edge, so the pixel's accumulated albedo and normal
            // match the chip on one side and the board on the other and agree
            // with NEITHER. Every tap is then rejected, the pixel receives
            // almost no filtering, and since it is also the kind of pixel that
            // keeps losing its history, nothing cleans it at all. That is the
            // crawl: not the filter flickering, the filter never running.
            //
            // A pixel with a long history does not need the help and keeps the
            // strict thresholds that stop colour bleeding between materials. A
            // pixel with one frame gets to borrow from its neighbours, which is
            // strictly better than staying raw. The world-radius test above
            // stays strict either way, so this can never reach across the board.
            const float wn = pow(max(dot(nC, nQ), 0.0), pc.sigma.x);
            const float wa = exp(-length(aC - aQ) / pc.sigma.z);
            // Brightness: preserves genuine lighting detail -- a shadow edge is
            // a real feature, not noise to be smoothed over.
            //
            // RELATIVE, not absolute. These are HDR values with no fixed range,
            // so a constant divisor is meaningless: at sigma 4 a typical
            // difference of well under 1 gave exp(-0.2) and this term rejected
            // nothing whatsoever. Scaling by the centre's own brightness makes
            // it behave the same in a bright region as a dark one.
            const float wl =
                exp(-abs(lC - luma(cQ)) / (pc.sigma.y * boost * max(lC, 0.05)));

            const float w = kernel[dx + 2] * kernel[dy + 2] * wn * wa * wl;
            sum += cQ * w;
            wsum += w;
        }
    }

    // wsum can only reach zero if every tap was rejected, including the centre;
    // fall back to the centre rather than emitting a black pixel.
    const vec3 outC = wsum > 1e-8 ? sum / wsum : centre;
    // Alpha carries the history length through the chain, so later passes scale
    // their strength the same way this one did. Dropping it here would leave
    // every pass after the first treating a converged pixel and a brand new one
    // identically.
    imageStore(dstImg, px, vec4(outC, srcC.a));
}
